# ══════════════════════════════════════════════════════════════════════════════
# FastPOS — Environment Variables Template
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./pos_database.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fastpos_db

# JWT Configuration
SECRET_KEY=CHANGE-ME-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=FastPOS
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

# Default Admin (created on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@fastpos.local

# Tax Rate (percentage)
TAX_RATE=10.0

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:8080/?payment=success
STRIPE_CANCEL_URL=http://localhost:8080/?payment=cancel

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fastpos.local
SMTP_FROM_NAME=FastPOS
SMTP_USE_TLS=true
