# Database
DATABASE_URL=sqlite+aiosqlite:///./pos_database.db

# JWT Configuration
SECRET_KEY=a7f3b9c2e1d4f8a6b5c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=FastPOS
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

# Default Admin (created on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@fastpos.local

# Tax Rate (percentage)
TAX_RATE=10.0

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/?payment=success
STRIPE_CANCEL_URL=http://localhost:8080/?payment=cancel

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fastpos.local
SMTP_FROM_NAME=FastPOS
SMTP_USE_TLS=true
